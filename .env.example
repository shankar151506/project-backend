# ========== Required Environment Variables ==========

# JWT signing secret – must be at least 32 characters, random and private.
JWT_SECRET=replace-with-a-private-random-value-at-least-32-characters

# MySQL database credentials (used by the default and prod profiles)
DB_URL=jdbc:mysql://localhost:3306/travel_companion_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Active Spring profile – set to "prod" for production, "local" for development
SPRING_PROFILES_ACTIVE=prod
